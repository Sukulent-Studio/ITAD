itad_labs:
  target: dev
  outputs:
    dev:
      type: duckdb
      # DuckDB - только вычислительный движок текущего запуска.
      # Staging и mart материализуются как Parquet в SeaweedFS.
      path: ":memory:"
      extensions:
        - httpfs
      settings:
        s3_endpoint: "{{ env_var('S3_ENDPOINT', 'localhost:8333') }}"
        s3_url_style: path
        s3_use_ssl: false
        s3_access_key_id: "{{ env_var('S3_ACCESS_KEY') }}"
        s3_secret_access_key: "{{ env_var('S3_SECRET_KEY') }}"
